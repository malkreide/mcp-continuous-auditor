# CI = the deterministic source of truth (Plan Phase 0 + Phase 2).
#
# TEMPLATE for the TARGET MCP-server repo (e.g. zurich-opendata-mcp) — NOT the
# auditor. pytest/mypy/ruff run against the MCP server code, and promptfoo evals
# the server's tools in-process. In the auditor repo there is no src/ to test,
# so this file ships as `.yml.template` and does not execute here.
#
# To activate in the target repo: copy to `.github/workflows/ci.yml`, then mark
# the `verify`, `determ` and `graded` jobs as REQUIRED status checks in branch
# protection on `main`. No deploy, no push to main — humans are the merge gate.
#
# The promptfoo layer is split at the credential boundary (Analysis T-C):
#   * determ — key-less contract + schema-drift + injection. No secrets, so it
#              runs on every PR (incl. forks). This is the deterministic gate.
#   * graded — the model-graded layer (llm-rubric + committed red-team). Needs a
#              grader key; runs the profile the credential-free Worker never does.

name: ci

on:
  pull_request:
  push:
    branches: [main]

permissions:
  contents: read

jobs:
  verify:
    name: ruff + mypy + pytest
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Install uv
        uses: astral-sh/setup-uv@v5
      - name: Set up Python
        run: uv python install 3.11
      - name: Sync dependencies
        run: uv sync --all-extras --dev
      # Ruff comes out of the target's OWN dev dependencies (`uv sync` above), so
      # the pin belongs in the target's committed `uv.lock` — not in this file,
      # which cannot override a synced environment without bypassing it. What
      # this step adds is the requirement: without a lockfile entry `uv sync`
      # re-resolves ruff on every run, and the next release that touches the
      # formatter turns this job red on untouched code — in every repo this
      # template was ever copied into, on the same day.
      - name: Ruff must be pinned by the lockfile, not resolved fresh
        run: |
          if [ ! -f uv.lock ]; then
            echo "::error::No committed uv.lock. Every tool this job runs, ruff included, is re-resolved on each run; an upstream release can turn CI red on untouched code. Commit the lockfile (\`uv lock\`)."
            exit 1
          fi
          if ! grep -q '^name = "ruff"$' uv.lock; then
            echo "::error::ruff is not in uv.lock. Add it to the dev dependencies so its version is pinned and a bump is a reviewable change."
            exit 1
          fi
          uv run ruff --version
      # Both gates run over the root AND over every subproject that carries its
      # own pyproject.toml.
      #
      # The reason is narrower than it looks, and worth stating exactly, because
      # the obvious reason is wrong. Ruff resolves configuration hierarchically:
      # for `ruff format --check .` at the root it already applies each file's
      # NEAREST pyproject.toml, so a subproject's own `line-length` is honoured
      # without any loop. Measured on this repo — a 95-character line under
      # `examples/worker-tdd-demo/` (line-length 100) passes the root-level run
      # and fails at the root's own width. A loop justified by differing widths
      # would therefore catch nothing at all.
      #
      # What the loop does catch is a root config whose `exclude` covers the
      # subproject: the directory run then skips it silently, while a path passed
      # explicitly is checked anyway (ruff does not apply `exclude` to explicit
      # arguments without `--force-exclude`) and still resolves that directory's
      # own settings. That is the one measured gap, so that is the one this
      # closes.
      #
      # Paths rather than `cd`: a subproject with its own pyproject.toml is its
      # own uv project, and `uv run` inside it would resolve a different
      # environment than the one `uv sync` above prepared.
      - name: Lint
        run: |
          uv run ruff check .
          for sub in $(find . -mindepth 2 -name pyproject.toml -not -path "./.venv/*" -not -path "./node_modules/*"); do
            echo "→ lint $(dirname "$sub")"
            uv run ruff check "$(dirname "$sub")"
          done
      # `ruff check` establishes nothing about formatting: a green linter beside a
      # red `ruff format --check` is an ordinary state, not a contradiction. Own
      # step so the log names which of the two failed — and the two are not
      # redundant, which is a claim this repo tests rather than asserts
      # (tests/test_format_gate.py formats lint-clean code badly and requires
      # `ruff check` to stay green while this gate goes red).
      #
      # Deliberately no `--line-length`: the width is the TARGET repo's decision,
      # read from its own ruff.toml / pyproject.toml. This template assumes none,
      # and must not — the portfolio runs 88, 100, 110 and 120 side by side.
      - name: Format
        run: |
          uv run ruff format --check .
          for sub in $(find . -mindepth 2 -name pyproject.toml -not -path "./.venv/*" -not -path "./node_modules/*"); do
            echo "→ format $(dirname "$sub")"
            uv run ruff format --check "$(dirname "$sub")"
          done
      - name: Type-check
        run: uv run mypy .
      - name: Test
        run: uv run pytest

  determ:
    # REQUIRED status check — the KEY-LESS deterministic gate (contract + schema
    # drift + injection). No secrets, so it runs on every PR incl. forks. Mark it
    # required in branch protection so a broken schema / contract stops the PR red
    # (Plan Phase 2: "a PR with a deliberately broken schema is stopped red by CI").
    name: promptfoo determ (contract + schema-drift, key-less)
    runs-on: ubuntu-latest
    needs: verify
    env:
      # Pin the truth-engine — never eval at @latest (a moving deterministic gate).
      PROMPTFOO_VERSION: "0.121.17"
      # "package.module:attr" — the module path and ATTRIBUTE NAME of the server
      # instance in the target repo. This convention names no class and is
      # unaffected by any SDK rename: the instance may be an
      # `mcp.server.mcpserver.MCPServer` (the official `mcp` SDK, 2.x — renamed
      # from `mcp.server.fastmcp.FastMCP`) or a `fastmcp.FastMCP` (the separate
      # PyPI project of that name, still current). The tooling asks the object
      # which it is; do not change this value because of a rename.
      MCP_SERVER_IMPORT: zurich_opendata_mcp.server:mcp
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: "20"
      - name: Install uv
        uses: astral-sh/setup-uv@v5
      # Installs the target's OWN deps. The in-memory client comes from whichever
      # SDK the target already depends on — the official `mcp` (>=2) or the
      # standalone `fastmcp` package. Neither is added here: they are different
      # projects and cannot be installed together.
      - name: Sync Python deps (the target's own SDK provides the in-memory client)
        run: uv sync --all-extras --dev
      - name: Schema-drift gate — regenerate from type hints, fail on any diff
        # Deterministic: if a tool's return type (or upstream shape) changed and
        # the committed schemas/ were not regenerated, this exits non-zero.
        run: uv run python schemas/generate_schemas.py --check
      - name: Install pinned promptfoo (npm ci from committed lockfile)
        # Reproducible transitive tree, integrity-checked — never re-resolves ranges
        # against a moving registry (Analysis T-G).
        run: cd promptfoo && npm ci --no-audit --no-fund
      - name: Run promptfoo determ profile (no model key required)
        run: |
          promptfoo/node_modules/.bin/promptfoo eval \
            -c promptfoo/promptfooconfig.determ.yaml

  graded:
    # REQUIRED status check — the MODEL-GRADED layer (llm-rubric + committed
    # red-team). This is the profile the credential-free Worker never runs; here in
    # CI a scoped grader key is available. Runs on every PR from the base repo.
    name: promptfoo graded (llm-rubric + red-team)
    runs-on: ubuntu-latest
    needs: verify
    env:
      # Writer family (the audited/tool provider path may use Anthropic).
      ANTHROPIC_API_KEY: ${{ secrets.ANTHROPIC_API_KEY }}
      # Independent grader — a DIFFERENT model family than the writer agent, so a
      # correlated failure mode cannot pass its own output. The config defaults the
      # llm-rubric grader to a non-Anthropic family; this key backs that default.
      # (Set GRADER_PROVIDER to a local ollama model to run the grader with no
      #  cloud key at all — see promptfoo/promptfooconfig.yaml.)
      OPENAI_API_KEY: ${{ secrets.OPENAI_API_KEY }}
      GRADER_PROVIDER: ${{ vars.GRADER_PROVIDER }}
      # Escape hatch for the writer!=grader guard below (leave unset in normal use).
      ALLOW_SAME_FAMILY_GRADER: ${{ vars.ALLOW_SAME_FAMILY_GRADER }}
      PROMPTFOO_VERSION: "0.121.17"
      MCP_SERVER_IMPORT: zurich_opendata_mcp.server:mcp
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: "20"
      - name: Install uv
        uses: astral-sh/setup-uv@v5
      # Installs the target's OWN deps. The in-memory client comes from whichever
      # SDK the target already depends on — the official `mcp` (>=2) or the
      # standalone `fastmcp` package. Neither is added here: they are different
      # projects and cannot be installed together.
      - name: Sync Python deps (the target's own SDK provides the in-memory client)
        run: uv sync --all-extras --dev
      - name: Enforce writer != grader family (independent check)
        # The writer/tool path is Anthropic; a same-family llm-rubric grader shares
        # its blind spots and is not independent. Refuse an Anthropic GRADER_PROVIDER
        # unless deliberately overridden. Unset -> the config's cross-family default.
        run: |
          case "${GRADER_PROVIDER:-}" in
            anthropic:*|anthropic/*|anthropic)
              if [ "${ALLOW_SAME_FAMILY_GRADER:-0}" != "1" ]; then
                echo "::error::GRADER_PROVIDER='${GRADER_PROVIDER}' is same-family as the Anthropic writer — writer != checker. Use a different family or set ALLOW_SAME_FAMILY_GRADER=1."
                exit 1
              fi
              echo "::warning::same-family grader allowed via ALLOW_SAME_FAMILY_GRADER=1 — not an independent check." ;;
          esac
      - name: Install pinned promptfoo (npm ci from committed lockfile)
        # Reproducible, integrity-checked transitive tree (Analysis T-G).
        run: cd promptfoo && npm ci --no-audit --no-fund
      - name: Run promptfoo graded profile (llm-rubric + committed red-team)
        # --grader override keeps writer != checker.
        run: |
          promptfoo/node_modules/.bin/promptfoo eval \
            -c promptfoo/promptfooconfig.yaml \
            ${GRADER_PROVIDER:+--grader "$GRADER_PROVIDER"}
      - name: Evaluate the generated red-team set (if committed)
        # The generative expansion (promptfoo/redteam/generate.sh) is committed via
        # a reviewed PR; eval it here when present so the expanded cases gate too.
        run: |
          if [ -f promptfoo/redteam/redteam.generated.yaml ]; then
            promptfoo/node_modules/.bin/promptfoo eval \
              -c promptfoo/redteam/redteam.generated.yaml \
              ${GRADER_PROVIDER:+--grader "$GRADER_PROVIDER"}
          else
            echo "no committed redteam.generated.yaml — skipping (run promptfoo/redteam/generate.sh to add it)"
          fi
